@host = http://localhost:8080
@subscriberId = 1
@formId = 1
@fieldId = 1
@responseId = 00000000-0000-0000-0000-000000000000
@provinceId = 8
@userId = 1
@roleId = 1013

### Health
GET {{host}}/api/health

### List provinces (lookup for Province fields)
GET {{host}}/api/provinces

### List cities of a province (lookup for City fields)
GET {{host}}/api/provinces/{{provinceId}}/cities

### List forms for subscriber
GET {{host}}/api/{{subscriberId}}/forms?pageNumber=1&pageSize=20
x-user-id: {{userId}}
x-role-id: {{roleId}}
x-subscriber-ids: [{{subscriberId}}]

### Create form
POST {{host}}/api/{{subscriberId}}/forms
Content-Type: application/json
x-user-id: {{userId}}
x-role-id: {{roleId}}
x-subscriber-ids: [{{subscriberId}}]

{
  "name": "Contact Us",
  "description": "Contact form",
  "slug": "contact-us",
  "createdBy": "admin"
}

### Get form
GET {{host}}/api/{{subscriberId}}/forms/{{formId}}
x-user-id: {{userId}}
x-role-id: {{roleId}}
x-subscriber-ids: [{{subscriberId}}]

### Add text field
POST {{host}}/api/{{subscriberId}}/forms/{{formId}}/fields
Content-Type: application/json
x-user-id: {{userId}}
x-role-id: {{roleId}}
x-subscriber-ids: [{{subscriberId}}]

{
  "name": "fullName",
  "label": "Full Name",
  "fieldType": "Text",
  "displayOrder": 0,
  "isRequired": true,
  "placeholder": "Jane Doe",
  "validationRules": [
    { "ruleType": "MinLength", "value": "2", "errorMessage": "Name is too short" },
    { "ruleType": "MaxLength", "value": "100", "errorMessage": "Name is too long" }
  ]
}

### Publish form
POST {{host}}/api/{{subscriberId}}/forms/{{formId}}/publish
Content-Type: application/json
x-user-id: {{userId}}
x-role-id: {{roleId}}
x-subscriber-ids: [{{subscriberId}}]

{
  "actor": "admin"
}

### Submit response (data entry — query subscriberId)
POST {{host}}/api/forms/{{formId}}/responses?subscriberId={{subscriberId}}
Content-Type: application/json

{
  "submittedBy": "jane@example.com",
  "values": [
    { "fieldId": "{{fieldId}}", "value": "Jane Doe" }
  ]
}

### List responses
GET {{host}}/api/forms/{{formId}}/responses?subscriberId={{subscriberId}}&pageNumber=1&pageSize=20

### Get response
GET {{host}}/api/responses/{{responseId}}?subscriberId={{subscriberId}}

### Create new version
POST {{host}}/api/{{subscriberId}}/forms/{{formId}}/versions
Content-Type: application/json
x-user-id: {{userId}}
x-role-id: {{roleId}}
x-subscriber-ids: [{{subscriberId}}]

{
  "actor": "admin"
}
