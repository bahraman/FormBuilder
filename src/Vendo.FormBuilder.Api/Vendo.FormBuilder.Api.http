@host = http://localhost:8080
@subscriberId = 1
@restaurantId = 10
@formId = 1
@fieldId = 1
@responseId = 00000000-0000-0000-0000-000000000000
@provinceId = 8

### Health
GET {{host}}/api/health

### List provinces (lookup for Province fields)
GET {{host}}/api/provinces

### List cities of a province (lookup for City fields)
GET {{host}}/api/provinces/{{provinceId}}/cities

### List forms for subscriber (all restaurants + shared)
GET {{host}}/api/forms?subscriberId={{subscriberId}}&pageNumber=1&pageSize=20

### List forms visible to a restaurant (restaurant-specific + shared)
GET {{host}}/api/forms?subscriberId={{subscriberId}}&restaurantId={{restaurantId}}&pageNumber=1&pageSize=20

### Create subscriber-level form (RestaurantId null = shared)
POST {{host}}/api/forms
Content-Type: application/json

{
  "subscriberId": {{subscriberId}},
  "name": "Contact Us",
  "description": "Shared across restaurants",
  "slug": "contact-us",
  "createdBy": "admin"
}

### Create restaurant-specific form
POST {{host}}/api/forms
Content-Type: application/json

{
  "subscriberId": {{subscriberId}},
  "restaurantId": {{restaurantId}},
  "name": "Local Feedback",
  "description": "Only for one restaurant",
  "slug": "local-feedback",
  "createdBy": "admin"
}

### Get form
GET {{host}}/api/forms/{{formId}}?subscriberId={{subscriberId}}

### Add text field
POST {{host}}/api/forms/{{formId}}/fields?subscriberId={{subscriberId}}
Content-Type: application/json

{
  "name": "fullName",
  "label": "Full Name",
  "fieldType": "Text",
  "displayOrder": 0,
  "isRequired": true,
  "placeholder": "Jane Doe",
  "validationRules": [
    { "ruleType": "MinLength", "value": "2", "errorMessage": "Name is too short" },
    { "ruleType": "MaxLength", "value": "100", "errorMessage": "Name is too long" }
  ]
}

### Publish form
POST {{host}}/api/forms/{{formId}}/publish?subscriberId={{subscriberId}}
Content-Type: application/json

{
  "actor": "admin"
}

### Submit response
POST {{host}}/api/forms/{{formId}}/responses?subscriberId={{subscriberId}}&restaurantId={{restaurantId}}
Content-Type: application/json

{
  "submittedBy": "jane@example.com",
  "values": [
    { "fieldId": "{{fieldId}}", "value": "Jane Doe" }
  ]
}

### List responses
GET {{host}}/api/forms/{{formId}}/responses?subscriberId={{subscriberId}}&pageNumber=1&pageSize=20

### Get response
GET {{host}}/api/responses/{{responseId}}?subscriberId={{subscriberId}}

### Create new version
POST {{host}}/api/forms/{{formId}}/versions?subscriberId={{subscriberId}}
Content-Type: application/json

{
  "actor": "admin"
}
