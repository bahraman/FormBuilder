<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!--
      IIS ships WebDAV enabled, which intercepts PUT and DELETE and answers
      405 Method Not Allowed before the request reaches ASP.NET Core.
      Removing the module and handler restores the REST verbs.
      Ignored when hosting on Kestrel or in Docker.
    -->
    <modules runAllManagedModulesForAllRequests="false">
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
  </system.webServer>
</configuration>
